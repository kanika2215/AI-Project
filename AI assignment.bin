      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "{'HF tasksource/folio (train subset)': 1000, 'GitHub FOLIO validation (204)': 204}\n"
          ]
        }
      ],
      "source": [
        "import json, urllib.request\n",
        "\n",
        "FOLIO_GITHUB_VAL = \"https://raw.githubusercontent.com/Yale-LILY/FOLIO/main/data/v0.0/folio-validation.jsonl\"\n",
        "\n",
        "def _as_list(x):\n",
        "    if x is None: return []\n",
        "    if isinstance(x, (list, tuple)): return [str(i) for i in x]\n",
        "    return [l for l in str(x).split(\"\\n\") if l.strip()]\n",
        "\n",
        "def folio_norm_label(x):\n",
        "    x = str(x).strip().capitalize()\n",
        "    return \"Uncertain\" if x in (\"Unknown\", \"Uncertain\") else x\n",
        "\n",
        "def gold_rows_from_hf(ds):\n",
        "    \"\"\"Use gold FOL columns of the Hugging Face FOLIO dataset (if present).\"\"\"\n",
        "    cols = list(ds.column_names)\n",
        "    pf = next((c for c in cols if \"premise\" in c.lower() and \"fol\" in c.lower()), None)\n",
        "    cf = next((c for c in cols if \"conclusion\" in c.lower() and \"fol\" in c.lower()), None)\n",
        "    if not (pf and cf): return None\n",
        "    return [{\"premises_fol\": _as_list(r[pf]), \"conclusion_fol\": str(r[cf]), \"label\": folio_norm_label(r[\"label\"])} for r in ds]\n",
        "\n",
        "def gold_rows_from_github(url=FOLIO_GITHUB_VAL):\n",
        "    raw = urllib.request.urlopen(url, timeout=60).read().decode(\"utf8\")\n",
        "    out = []\n",
        "    for l in raw.splitlines():\n",
        "        if l.strip():\n",
        "            r = json.loads(l)\n",
        "            out.append({\"premises_fol\": _as_list(r[\"premises-FOL\"]), \"conclusion_fol\": r[\"conclusion-FOL\"],\n",
        "                        \"label\": folio_norm_label(r[\"label\"])})\n",
        "    return out\n",
        "\n",
        "FOLIO_GOLD = {}\n",
        "try:\n",
        "    g = gold_rows_from_hf(raw_folio)\n",
        "    if g: FOLIO_GOLD[\"HF tasksource/folio (train subset)\"] = g\n",
        "except Exception as e:\n",
        "    print(\"HF gold-FOL columns unavailable:\", repr(e))\n",
        "try:\n",
        "    FOLIO_GOLD[\"GitHub FOLIO validation (204)\"] = gold_rows_from_github()\n",
        "except Exception as e:\n",
        "    print(\"GitHub download failed:\", repr(e))\n",
        "print({k: len(v) for k, v in FOLIO_GOLD.items()})\n"
      ]
    },
