      "source": [
        "from collections import Counter\n",
        "import time\n",
        "\n",
        "def run(rows, verbose=True, show_errors=10, predictor=None):\n",
        "    predictor = predictor or predict\n",
        "\n",
        "    t0 = time.perf_counter()\n",
        "    preds = []\n",
        "\n",
        "    for r in rows:\n",
        "        p = predictor(r[\"context\"], r[\"question\"])\n",
        "        preds.append(p is True or p == \"True\")\n",
        "\n",
        "    dt = time.perf_counter() - t0\n",
        "\n",
        "    out = {\n",
        "        \"preds\": preds,\n",
        "        \"time\": dt\n",
        "    }\n",
        "\n",
        "    if not rows or rows[0].get(\"label\") is None:\n",
        "        if verbose:\n",
        "            print(f\"queries={len(rows)}  inference time={dt:.3f}s\")\n",
        "        return out\n",
        "\n",
        "    gold = [norm_label(r[\"label\"]) for r in rows]\n",
        "\n",
        "    TP = sum(p and g for p, g in zip(preds, gold))\n",
        "    TN = sum(not p and not g for p, g in zip(preds, gold))\n",
        "    FP = sum(p and not g for p, g in zip(preds, gold))\n",
        "    FN = sum(not p and g for p, g in zip(preds, gold))\n",
        "\n",
        "    total = len(rows)\n",
        "    correct = TP + TN\n",
        "\n",
        "    accuracy = 100 * correct / total if total else 0\n",
        "    precision = TP / (TP + FP) if TP + FP else 0\n",
        "    recall = TP / (TP + FN) if TP + FN else 0\n",
        "    f1 = (\n",
        "        2 * precision * recall / (precision + recall)\n",
        "        if precision + recall else 0\n",
        "    )\n",
        "\n",
        "    positive_accuracy = (\n",
        "        100 * TP / (TP + FN) if TP + FN else 0\n",
        "    )\n",
        "    negative_accuracy = (\n",
        "        100 * TN / (TN + FP) if TN + FP else 0\n",
        "    )\n",
        "\n",
        "    out.update({\n",
        "        \"accuracy\": accuracy,\n",
        "        \"precision\": precision,\n",
        "        \"recall\": recall,\n",
        "        \"f1\": f1,\n",
        "        \"TP\": TP,\n",
        "        \"TN\": TN,\n",
        "        \"FP\": FP,\n",
        "        \"FN\": FN,\n",
        "        \"positive_accuracy\": positive_accuracy,\n",
        "        \"negative_accuracy\": negative_accuracy\n",
        "    })\n",
        "\n",
        "    errors = []\n",
        "\n",
        "    for r, p, g in zip(rows, preds, gold):\n",
        "        if p != g:\n",
        "            _, bad = parse_context(r[\"context\"])\n",
        "\n",
        "            errors.append({\n",
        "                \"question\": r[\"question\"],\n",
        "                \"context\": r[\"context\"],\n",
        "                \"actual_label\": r[\"label\"],\n",
        "                \"expected\": g,\n",
        "                \"predicted\": p,\n",
        "                \"parser_errors\": bad\n",
        "            })\n",
        "\n",
        "    out[\"errors\"] = errors\n",
        "    out[\"error_count\"] = len(errors)\n",
        "    out[\"label_distribution\"] = dict(\n",
        "        Counter(str(r[\"label\"]).lower() for r in rows)\n",
        "    )\n",
        "\n",
        "    if verbose:\n",
        "        print(f\"\\nQueries: {total}\")\n",
        "        print(f\"Inference time: {dt:.3f}s\")\n",
        "        print(f\"Accuracy: {accuracy:.2f}%\")\n",
        "\n",
        "        print(\"\\n--- Classification Metrics ---\")\n",
        "        print(f\"Precision: {precision:.4f}\")\n",
        "        print(f\"Recall:    {recall:.4f}\")\n",
        "        print(f\"F1-score:  {f1:.4f}\")\n",
        "\n",
        "        print(\"\\n--- Confusion Matrix ---\")\n",
        "        print(\"                 Predicted\")\n",
        "        print(\"                 False    True\")\n",
        "        print(f\"Actual False     {TN:5d}    {FP:5d}\")\n",
        "        print(f\"Actual True      {FN:5d}    {TP:5d}\")\n",
        "\n",
        "        print(\"\\n--- Class-wise Accuracy ---\")\n",
        "        print(f\"Entailment (True):        {positive_accuracy:.2f}%\")\n",
        "        print(f\"Not entailment (False):   {negative_accuracy:.2f}%\")\n",
        "\n",
        "        print(\"\\n--- Original Label Distribution ---\")\n",
        "        for label, count in out[\"label_distribution\"].items():\n",
        "            print(f\"{label}: {count}\")\n",
        "\n",
        "        print(f\"\\n--- Incorrect Predictions: {len(errors)} ---\")\n",
        "\n",
        "        for i, e in enumerate(errors[:show_errors], 1):\n",
        "            print(f\"\\nError {i}\")\n",
        "            print(\"Question:\", e[\"question\"])\n",
        "            print(\"Actual label:\", e[\"actual_label\"])\n",
        "            print(\"Expected:\", e[\"expected\"])\n",
        "            print(\"Predicted:\", e[\"predicted\"])\n",
        "            print(\"Parser errors:\", e[\"parser_errors\"])\n",
        "            print(\"Context:\", e[\"context\"][:500])\n",
        "\n",
        "        if len(errors) > show_errors:\n",
        "            print(f\"\\nShowing {show_errors} of {len(errors)} errors.\")\n",
        "\n",
        "    return out\n"
      ]
    },
