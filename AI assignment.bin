            "  True       [218, 6, 163]\n",
            "  False      [15, 139, 135]\n",
            "  Uncertain  [6, 9, 309]\n",
            "mismatching example indices: [2, 3, 4, 12, 13, 14, 17, 18, 20, 21, 22, 25] ...\n",
            "\n",
            "## GitHub FOLIO validation (204)\n",
            "examples=204  inference time=21.45s\n",
            "3-class accuracy (True/False/Uncertain): 95.59%\n",
            "binary accuracy  (entailed vs not)     : 98.04%\n",
            "rows=gold, cols=pred ['True', 'False', 'Uncertain']\n",
            "  True       [68, 0, 4]\n",
            "  False      [0, 59, 4]\n",
