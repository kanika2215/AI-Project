      "source": [
        "## Prediction and evaluation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "id": "fe7c1b57",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-11-03T13:42:07.259148Z",
          "iopub.status.busy": "2026-11-03T13:42:07.259028Z",
          "iopub.status.idle": "2026-11-03T13:42:07.266035Z",
          "shell.execute_reply": "2026-11-03T13:42:07.265468Z"
        },
