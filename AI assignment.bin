      "source": [
        "import json, urllib.request\n",
        "FOLIO_SOURCE, FOLIO_SPLIT, FOLIO_MAX_ROWS, FOLIO_SEED = \"tasksource/folio\", \"train\", 1000, 42\n",
        "FOLIO_GITHUB_TRAIN = \"https://raw.githubusercontent.com/Yale-LILY/FOLIO/main/data/v0.0/folio-train.jsonl\"\n",
        "raw_folio, folio_rows = None, []\n",
        "try:\n",
        "    from datasets import load_dataset\n",
        "    raw_folio = load_dataset(FOLIO_SOURCE, split=FOLIO_SPLIT).shuffle(seed=FOLIO_SEED)\n",
        "    if FOLIO_MAX_ROWS is not None:\n",
        "        raw_folio = raw_folio.select(range(min(FOLIO_MAX_ROWS, len(raw_folio))))\n",
        "    folio_rows = [{\"id\": row.get(\"example_id\"), \"context\": row[\"premises\"], \"question\": row[\"conclusion\"],\n",
        "                   \"label\": str(row[\"label\"]).strip().capitalize()} for row in raw_folio]\n",
        "    print(\"FOLIO loaded from Hugging Face:\", len(folio_rows), \"examples\")\n",
        "except Exception as e:\n",
        "    print(\"Hugging Face unavailable (\", type(e).__name__, \") -> using the official FOLIO GitHub copy\")\n",
        "    try:\n",
        "        raw = urllib.request.urlopen(FOLIO_GITHUB_TRAIN, timeout=60).read().decode(\"utf8\")\n",
        "        for k, l in enumerate(x for x in raw.splitlines() if x.strip()):\n",
        "            r = json.loads(l)\n",
        "            folio_rows.append({\"id\": k, \"context\": \"\\n\".join(r[\"premises\"]), \"question\": r[\"conclusion\"],\n",
        "                               \"label\": \"Uncertain\" if r[\"label\"] in (\"Unknown\", \"Uncertain\") else r[\"label\"]})\n",
        "        print(\"FOLIO loaded from GitHub:\", len(folio_rows), \"examples\")\n",
        "    except Exception as e2:\n",
        "        print(\"FOLIO loading failed:\", repr(e2))\n"
      ]
    },
