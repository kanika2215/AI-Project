      "source": [
        "RULETAKER_SOURCE = \"tasksource/ruletaker\"\n",
        "RULETAKER_SPLIT = \"dev\"\n",
        "RULETAKER_MAX_ROWS = 1000\n",
        "RULETAKER_SEED = 42\n",
        "\n",
        "try:\n",
        "    rt_rows = load_rows(\n",
        "        RULETAKER_SOURCE,\n",
        "        split=RULETAKER_SPLIT,\n",
        "        max_rows=RULETAKER_MAX_ROWS,\n",
        "        shuffle_seed=RULETAKER_SEED\n",
        "    )\n",
        "\n",
        "    print(\"RuleTaker examples loaded:\", len(rt_rows))\n",
        "\n",
        "    FORCE_MODE = \"cwa\"\n",
        "    UNKNOWN_AS = False\n",
        "    _KB_CACHE.clear()\n",
        "\n",
        "    rt_result = run(\n",
        "        rt_rows,\n",
        "        verbose=True,\n",
        "        show_errors=15\n",
        "    )\n",
        "\n",
        "except Exception as e:\n",
        "    print(\"RuleTaker evaluation failed:\", repr(e))\n"
      ]
    },
