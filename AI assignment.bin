      "outputs": [],
      "source": [
        "import re, time, heapq, itertools\n",
        "from collections import defaultdict\n",
        "\n",
        "F2_TOK = re.compile(r\"∀|∃|¬|∧|∨|⊕|→|↔|⟷|⇒|\\(|\\)|,|[^\\s()∀∃¬∧∨⊕→↔⟷⇒,]+\")\n",
        "def f2_norm(s):\n",
        "    for a, b in ((\"<->\",\"↔\"),(\"<=>\",\"↔\"),(\"->\",\"→\"),(\"=>\",\"→\"),(\"&\",\"∧\"),(\"^\",\"∧\"),(\"|\",\"∨\"),(\"~\",\"¬\"),(\"!\",\"¬\"),\n",
        "                 (\"forall \",\"∀\"),(\"exists \",\"∃\"),(\"ForAll \",\"∀\"),(\"Exists \",\"∃\"),(\" xor \",\"⊕\"),(\"≠\",\"!=\")):\n",
        "        s = s.replace(a, b)\n",
        "    return s\n",
        "\n",
        "_F2OPS = {\"∀\",\"∃\",\"¬\",\"∧\",\"∨\",\"⊕\",\"→\",\"↔\",\"⟷\",\"⇒\",\")\",\"(\",\",\",\"=\",\"!=\"}\n",
        "class F2Parser:\n",
        "    \"\"\"precedence (high->low): ¬  ∧  ∨  ⊕  →  ↔ ; quantifiers bind the next unary formula.\"\"\"\n",
        "    def __init__(s, text):\n",
        "        toks = F2_TOK.findall(f2_norm(text)); d = 0; out = []\n",
        "        for x in toks:\n",
        "            if x == \"(\": d += 1\n",
        "            elif x == \")\":\n",
        "                if d == 0: continue\n",
        "                d -= 1\n",
        "            out.append(x)\n",
        "        s.t = out + [\")\"] * d; s.i = 0; s.bound = []\n",
        "    def peek(s): return s.t[s.i] if s.i < len(s.t) else None\n",
        "    def nxt(s): x = s.peek(); s.i += 1; return x\n",
        "    def expect(s, x):\n",
        "        if s.nxt() != x: raise ValueError(\"FOL parse error: expected \" + x)\n",
        "    def parse(s):\n",
        "        f = s.iff()\n",
        "        if s.peek() is not None: raise ValueError(\"FOL parse error: trailing tokens\")\n",
        "        return f\n",
        "    def iff(s):\n",
        "        l = s.imp()\n",
        "        while s.peek() in (\"↔\", \"⟷\"): s.nxt(); l = (\"iff\", l, s.imp())\n",
        "        return l\n",
        "    def imp(s):\n",
        "        l = s.xor()\n",
        "        if s.peek() in (\"→\", \"⇒\"): s.nxt(); return (\"imp\", l, s.imp())\n",
        "        return l\n",
        "    def xor(s):\n",
        "        l = s.or_()\n",
        "        while s.peek() == \"⊕\": s.nxt(); l = (\"xor\", l, s.or_())\n",
        "        return l\n",
        "    def or_(s):\n",
        "        l = s.and_()\n",
        "        while s.peek() == \"∨\": s.nxt(); l = (\"or\", l, s.and_())\n",
        "        return l\n",
        "    def and_(s):\n",
        "        l = s.unary()\n",
        "        while True:\n",
        "            if s.peek() in (\"∧\", \",\"): s.nxt(); l = (\"and\", l, s.unary())\n",
        "            elif s.peek() is not None and s.peek() not in _F2OPS and s.peek() not in (\")\", \"(\") :\n",
        "                l = (\"and\", l, s.unary())\n",
        "            else: return l\n",
        "        return l\n",
        "    def term(s):\n",
        "        n = s.nxt()\n",
        "        if n is None or n in \"()∧∨⊕→↔,\": raise ValueError(\"FOL parse error: bad term\")\n",
        "        if s.peek() == \"(\":\n",
        "            s.nxt(); a = [s.term()]\n",
        "            while s.peek() == \",\": s.nxt(); a.append(s.term())\n",
        "            s.expect(\")\"); return (n.lower(),) + tuple(a)\n",
        "        while s.peek() is not None and s.peek() not in _F2OPS and s.peek() != \"(\":\n",
        "            n += \"_\" + s.nxt()\n",
        "        return \"?\" + n if n in s.bound else n.lower()\n",
        "    def unary(s):\n",
        "        t = s.peek()\n",
        "        if t == \"¬\": s.nxt(); return (\"not\", s.unary())\n",
        "        if t in (\"∀\", \"∃\"):\n",
        "            s.nxt(); vs = [s.nxt()]\n",
        "            while s.peek() == \",\": s.nxt(); vs.append(s.nxt())\n",
        "            s.bound.extend(vs); body = s.unary()\n",
        "            for _ in vs: s.bound.pop()\n",
        "            for v in reversed(vs): body = (\"forall\" if t == \"∀\" else \"exists\", \"?\" + v, body)\n",
        "            return body\n",
        "        if t == \"(\":\n",
        "            s.nxt(); f = s.iff(); s.expect(\")\"); return f\n",
        "        n = s.nxt()\n",
        "        if n is None or n in \"()∧∨⊕→↔,\": raise ValueError(\"FOL parse error at \" + str(n))\n",
        "        args = []\n",
        "        if s.peek() == \"(\":\n",
        "            s.nxt(); args = [s.term()]\n",
        "            while s.peek() == \",\": s.nxt(); args.append(s.term())\n",
        "            s.expect(\")\")\n",
        "        elif s.peek() in (\"=\", \"!=\"):\n",
        "            op = s.nxt(); r = s.term(); a = (\"atom\", \"=\", ((\"?\" + n if n in s.bound else n.lower()), r))\n",
        "            return a if op == \"=\" else (\"not\", a)\n",
        "        return (\"atom\", n.lower(), tuple(args))\n",
        "\n",
        "def f2_parse(s): return F2Parser(s.strip().rstrip(\".\")).parse()\n",
        "def f2_parse_many(lst):\n",
        "    out = []\n",
        "    for p in lst:\n",
        "        if p and p.strip():\n",
        "            try: out.append(f2_parse(p))\n",
        "            except ValueError: pass\n",
        "    return out\n",
        "\n",
        "_f2c = itertools.count()\n",
        "def _f2nnf(f, neg=False):\n",
        "    op = f[0]\n",
        "    if op == \"atom\": return (\"not\", f) if neg else f\n",
        "    if op == \"not\": return _f2nnf(f[1], not neg)\n",
        "    if op == \"and\": return (\"or\" if neg else \"and\", _f2nnf(f[1], neg), _f2nnf(f[2], neg))\n",
        "    if op == \"or\":  return (\"and\" if neg else \"or\", _f2nnf(f[1], neg), _f2nnf(f[2], neg))\n",
        "    if op == \"imp\": return _f2nnf((\"or\", (\"not\", f[1]), f[2]), neg)\n",
        "    if op == \"iff\": return _f2nnf((\"and\", (\"imp\", f[1], f[2]), (\"imp\", f[2], f[1])), neg)\n",
        "    if op == \"xor\": return _f2nnf((\"and\", (\"or\", f[1], f[2]), (\"not\", (\"and\", f[1], f[2]))), neg)\n",
        "    q = op if not neg else (\"exists\" if op == \"forall\" else \"forall\")\n",
        "    return (q, f[1], _f2nnf(f[2], neg))\n",
        "def _f2sub(t, env):\n",
        "    if isinstance(t, tuple): return (t[0],) + tuple(_f2sub(x, env) for x in t[1:])\n",
        "    return env.get(t, t)\n",
        "def _f2sk(f, env, univ):\n",
        "    op = f[0]\n",
        "    if op == \"forall\":\n",
        "        v = \"?%s_%d\" % (f[1][1:], next(_f2c)); return _f2sk(f[2], {**env, f[1]: v}, univ + [v])\n",
        "    if op == \"exists\":\n",
        "        n = next(_f2c); t = (\"sk%d\" % n,) + tuple(univ) if univ else \"sk%d\" % n\n",
        "        return _f2sk(f[2], {**env, f[1]: t}, univ)\n",
        "    if op in (\"and\", \"or\"): return (op, _f2sk(f[1], env, univ), _f2sk(f[2], env, univ))\n",
        "    if op == \"not\": a = f[1]; return (\"not\", (\"atom\", a[1], tuple(_f2sub(x, env) for x in a[2])))\n",
        "    return (\"atom\", f[1], tuple(_f2sub(x, env) for x in f[2]))\n",
        "def _f2cnf(f):\n",
        "    op = f[0]\n",
        "    if op == \"and\": return _f2cnf(f[1]) + _f2cnf(f[2])\n",
        "    if op == \"or\":  return [x + y for x in _f2cnf(f[1]) for y in _f2cnf(f[2])]\n",
        "    if op == \"not\": return [[Lit(True, f[1][1], f[1][2])]]\n",
        "    return [[Lit(False, f[1], f[2])]]\n",
        "def f2_clauses(ast): return [tuple(c) for c in _f2cnf(_f2sk(_f2nnf(ast), {}, []))]\n",
        "\n",
        "def _f2walk(t, s):\n",
        "    while is_var(t) and t in s: t = s[t]\n",
        "    return t\n",
        "def _f2occ(v, t, s):\n",
        "    t = _f2walk(t, s); return t == v or (isinstance(t, tuple) and any(_f2occ(v, x, s) for x in t[1:]))\n",
        "def _f2unify(a, b, s):\n",
        "    a, b = _f2walk(a, s), _f2walk(b, s)\n",
        "    if a == b: return s\n",
        "    if is_var(a): return None if _f2occ(a, b, s) else {**s, a: b}\n",
        "    if is_var(b): return None if _f2occ(b, a, s) else {**s, b: a}\n",
        "    if isinstance(a, tuple) and isinstance(b, tuple) and len(a) == len(b) and a[0] == b[0]:\n",
        "        for x, y in zip(a[1:], b[1:]):\n",
        "            s = _f2unify(x, y, s)\n",
        "            if s is None: return None\n",
        "        return s\n",
        "    return None\n",
        "def _f2unify_args(A, B, s):\n",
        "    for x, y in zip(A, B):\n",
        "        s = _f2unify(x, y, s)\n",
        "        if s is None: return None\n",
        "    return s\n",
        "def _f2sb(t, s):\n",
        "    t = _f2walk(t, s); return (t[0],) + tuple(_f2sb(x, s) for x in t[1:]) if isinstance(t, tuple) else t\n",
        "def _f2rn(t, tag):\n",
        "    if isinstance(t, tuple): return (t[0],) + tuple(_f2rn(x, tag) for x in t[1:])\n",
        "    return t + tag if is_var(t) else t\n",
        "def _f2match(p, t, s):\n",
        "    if is_var(p):\n",
        "        if p in s: return s if s[p] == t else None\n",
        "        return {**s, p: t}\n",
        "    if isinstance(p, tuple):\n",
        "        if not (isinstance(t, tuple) and len(p) == len(t) and p[0] == t[0]): return None\n",
        "        for x, y in zip(p[1:], t[1:]):\n",
        "            s = _f2match(x, y, s)\n",
        "            if s is None: return None\n",
        "        return s\n",
        "    return s if p == t else None\n",
        "def _f2subsumes(c, d):\n",
        "    \"\"\"True if some substitution maps clause c into a subset of clause d.\"\"\"\n",
        "    def rec(i, s):\n",
        "        if i == len(c): return True\n",
        "        l = c[i]\n",
        "        for m in d:\n",
        "            if m.neg == l.neg and m.pred == l.pred and len(m.args) == len(l.args):\n",
        "                t = s\n",
        "                for a, b in zip(l.args, m.args):\n",
        "                    t = _f2match(a, b, t)\n",
        "                    if t is None: break\n",
        "                if t is not None and rec(i + 1, t): return True\n",
        "        return False\n",
        "    return rec(0, {})\n",
        "def _f2clean(cl):\n",
        "    out = []\n",
        "    for l in cl:\n",
        "        if l not in out: out.append(l)\n",
        "    S = set(out)\n",
        "    if any(neg_lit(l) in S for l in out): return None\n",
        "    return tuple(out)\n",
        "def _f2size(t): return 1 + sum(_f2size(x) for x in t[1:]) if isinstance(t, tuple) else 1\n",
        "def _f2weight(cl): return sum(1 + sum(_f2size(a) for a in l.args) for l in cl)\n",
        "\n",
        "def f2_refute(axioms, goal, max_clauses=20000, tlimit=3.0):\n",
        "    \"\"\"Resolution refutation (set-of-support).  True = proof found; False = saturated (no proof exists);\n",
        "       None = resource limit reached.\"\"\"\n",
        "    t0 = time.time(); idx = defaultdict(list); sos = []; cnt = itertools.count(); fresh = itertools.count()\n",
        "    bucket = defaultdict(list)\n",
        "    EMPTY = object()\n",
        "    sig = lambda l: (l.pred, l.neg)\n",
        "    def subsumed(cl):\n",
        "        sg = {sig(l) for l in cl}\n",
        "        for sgn in sg:\n",
        "            for c in bucket[sgn]:\n",
        "                if len(c) <= len(cl) and _f2subsumes(c, cl): return True\n",
        "        return False\n",
        "    def keep(cl): bucket[min(sig(l) for l in cl)].append(cl)\n",
        "    def push(cl):\n",
        "        cl = _f2clean(cl)\n",
        "        if cl is None: return None\n",
        "        if not cl: return EMPTY\n",
        "        if subsumed(cl): return None\n",
        "        keep(cl); heapq.heappush(sos, (_f2weight(cl), next(cnt), cl)); return None\n",
        "    def usable(cl):\n",
        "        for k in {sig(l) for l in cl}: idx[k].append(cl)\n",
        "    for c in axioms:\n",
        "        c = _f2clean(c)\n",
        "        if c is None: continue\n",
        "        if not c: return True\n",
        "        if not subsumed(c): keep(c); usable(c)\n",
        "    for c in goal:\n",
        "        if push(c) is EMPTY: return True\n",
        "    n = 0\n",
        "    while sos:\n",
        "        if n > max_clauses or time.time() - t0 > tlimit: return None\n",
        "        _, _, g = heapq.heappop(sos); n += 1\n",
        "        usable(g)\n",
        "        for i in range(len(g)):\n",
        "            for j in range(i + 1, len(g)):\n",
        "                if g[i].neg == g[j].neg and g[i].pred == g[j].pred and len(g[i].args) == len(g[j].args):\n",
        "                    s = _f2unify_args(g[i].args, g[j].args, {})\n",
        "                    if s is not None and push([Lit(x.neg, x.pred, tuple(_f2sb(a, s) for a in x.args)) for x in g]) is EMPTY:\n",
        "                        return True\n",
        "        for i, l in enumerate(g):\n",
        "            for c2 in list(idx[(l.pred, not l.neg)]):\n",
        "                tag = \"_%d\" % next(fresh)\n",
        "                c2r = [Lit(x.neg, x.pred, tuple(_f2rn(a, tag) for a in x.args)) for x in c2]\n",
        "                for j, m in enumerate(c2r):\n",
        "                    if m.neg != l.neg and m.pred == l.pred and len(m.args) == len(l.args):\n",
        "                        s = _f2unify_args(l.args, m.args, {})\n",
        "                        if s is None: continue\n",
        "                        res = [Lit(x.neg, x.pred, tuple(_f2sb(a, s) for a in x.args)) for k, x in enumerate(g) if k != i] + \\\n",
        "                              [Lit(x.neg, x.pred, tuple(_f2sb(a, s) for a in x.args)) for k, x in enumerate(c2r) if k != j]\n",
        "                        if push(res) is EMPTY: return True\n",
        "    return False\n",
        "\n",
        "def f2_entails(prem_fol, concl_fol, three_way=False, tlimit=3.0):\n",
        "    \"\"\"binary: True iff premises ⊨ conclusion.  three_way: 'True' / 'False' / 'Uncertain'.\"\"\"\n",
        "    ax = [c for p in prem_fol for c in f2_clauses(f2_parse(p))]\n",
        "    C = f2_parse(concl_fol)\n",
        "    if f2_refute(ax, f2_clauses((\"not\", C)), tlimit=tlimit) is True: return \"True\" if three_way else True\n",
        "    if not three_way: return False\n",
        "    if f2_refute(ax, f2_clauses(C), tlimit=tlimit) is True: return \"False\"\n",
        "    return \"Uncertain\"\n",
        "\n",
        "parse_fol, fol_clauses, refute, fol_entails = f2_parse, f2_clauses, f2_refute, f2_entails\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "65b4e164",
      "metadata": {
        "id": "65b4e164"
      },
      "source": [
        "## Counterfactual reasoning"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "id": "a70ccfcc",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-11-03T13:42:07.238523Z",
          "iopub.status.busy": "2026-11-03T13:42:07.238270Z",
          "iopub.status.idle": "2026-11-03T13:42:07.257573Z",
          "shell.execute_reply": "2026-11-03T13:42:07.254260Z"
        },
        "id": "a70ccfcc"
      },
      "outputs": [],
      "source": [
        "import re, itertools\n",
        "from collections import defaultdict\n",
        "\n",
        "def cb_norm(s): return re.sub(r\"\\s+\", \" \", s.strip().lower().strip(\" .,;\"))\n",
        "\n",
        "def cb_lits(text):\n",
        "    \"\"\"'not a and b' / 'a, not b' -> [(var, negated)]\"\"\"\n",
        "    out = []\n",
        "    for p in re.split(r\",|\\band\\b\", text):\n",
        "        p = cb_norm(p)\n",
        "        if not p: continue\n",
        "        neg = False\n",
        "        while p.startswith(\"not \"): neg = not neg; p = p[4:].strip()\n",
        "        m = re.match(r\"^(.*?)\\s+(?:does\\s+|do\\s+|did\\s+)?not\\s+(?:occur|occurs|happen|happens)$\", p)\n",
        "        if m: p, neg = m.group(1).strip(), not neg\n",
        "        else:\n",
        "            m = re.match(r\"^(.*?)\\s+(?:occur|occurs|occurred|happen|happens)$\", p)\n",
        "            if m: p = m.group(1).strip()\n",
        "        if p: out.append((p, neg))\n",
        "    return out\n",
        "\n",
        "def cb_parse_equations(sentence):\n",
        "    \"\"\"'A causes B, B and C together cause D, E or F causes G, not H causes I, J causes K, L and M' -> equations\"\"\"\n",
        "    s = re.sub(r\"^\\s*(?:we know that|we know|given that)\\s+\", \"\", sentence.strip(), flags=re.I)\n",
        "    segs = [x.strip() for x in s.split(\",\") if x.strip()]\n",
        "    clauses = []\n",
        "    for seg in segs:\n",
        "        seg = re.sub(r\"^and\\s+\", \"\", seg, flags=re.I)\n",
        "        m = re.match(r\"(.*?)\\b(?:causes|cause)\\b(.*)$\", seg, flags=re.I)\n",
        "        if m:\n",
        "            clauses.append([m.group(1), [m.group(2)]])\n",
        "        elif clauses:\n",
        "            clauses[-1][1].append(seg)\n",
        "    eqs = defaultdict(list)\n",
        "    for lhs, rhs_parts in clauses:\n",
        "        lhs = re.sub(r\"\\btogether\\b\", \" \", lhs, flags=re.I)\n",
        "        dnf = []\n",
        "        for disj in re.split(r\"\\bor\\b\", lhs, flags=re.I):\n",
        "            conj = cb_lits(disj)\n",
        "            if conj: dnf.append(conj)\n",
        "        if not dnf: continue\n",
        "        for part in rhs_parts:\n",
        "            for eff, neg in cb_lits(part):\n",
        "                eqs[eff].append((dnf, neg))\n",
        "    return eqs\n",
        "\n",
        "def cb_parse(text):\n",
        "    \"\"\"parse a full instance (context + question) -> dict(eqs, observed, do, factual, target)\"\"\"\n",
        "    t = re.sub(r\"\\b\\S+\\s+Bern\\([^)]*\\)\\.?\", \" \", text)\n",
        "    t = re.sub(r\"\\s+\", \" \", t)\n",
        "    sents = [x.strip() for x in re.split(r\"(?<=[.?!])\\s+\", t) if x.strip()]\n",
        "    eqs = defaultdict(list); observed = []; question = []\n",
        "    for s in sents:\n",
        "        low = s.lower()\n",
        "        if re.search(r\"\\bwould\\b|\\bassume\\b|\\bsuppose\\b\", low) or low.endswith(\"?\"):\n",
        "            question.append(s); continue\n",
        "        if \"direct effect\" in low or \"unobserved\" in low or low.startswith(\"imagine\"):\n",
        "            if \"we know that\" not in low: continue\n",
        "            s = s[low.index(\"we know that\"):]\n",
        "        m = re.match(r\"\\s*we (?:also )?observed?\\s+(.*)$\", s, flags=re.I)\n",
        "        if m: observed += cb_lits(m.group(1)); continue\n",
        "        if re.search(r\"\\bcauses?\\b\", low):\n",
        "            for k, v in cb_parse_equations(s).items(): eqs[k] += v\n",
        "    q = \" \".join(question); ql = q.lower()\n",
        "    do = []; factual = []; target = None\n",
        "    m = re.search(r\"would\\s+(.*?)\\s+(not\\s+)?(?:still\\s+)?(?:occur|happen|be true)\", ql)\n",
        "    if m:\n",
        "        tl = cb_lits(m.group(1)); target = tl[0] if tl else None\n",
        "        if target and m.group(2): target = (target[0], not target[1])\n",
        "    if \"assume\" in ql or \"suppose\" in ql:\n",
        "        for m in re.finditer(r\"(?:assume|suppose)\\s+(?:that\\s+)?(.*?)(?=,?\\s*and based on|,?\\s*further|\\.|\\?|$)\", ql):\n",
        "            do += cb_lits(m.group(1))\n",
        "    else:\n",
        "        m = re.search(r\"\\bif\\s+(.*?)(?:\\s+instead of\\s+(.*?))?\\s*\\??\\s*$\", ql)\n",
        "        if m:\n",
        "            do += cb_lits(m.group(1))\n",
        "            if m.group(2): factual += cb_lits(m.group(2))\n",
        "    return {\"eqs\": eqs, \"observed\": observed, \"do\": do, \"factual\": factual, \"target\": target, \"question\": q}\n",
        "\n",
        "def cb_solve(P, trace=False):\n",
        "    \"\"\"returns (answer_bool, trace_text)\"\"\"\n",
        "    eqs, do_l, obs, fact, target = P[\"eqs\"], P[\"do\"], P[\"observed\"], P[\"factual\"], P[\"target\"]\n",
        "    if target is None: return False, \"no target found\"\n",
        "    names = set(eqs) | {v for dnf_l in eqs.values() for dnf, _ in dnf_l for c in dnf for v, _ in c}\n",
        "    names |= {v for v, _ in obs + do_l + fact} | {target[0]}\n",
        "    roots = sorted(n for n in names if n not in eqs)\n",
        "\n",
        "    def make_eval(roots_val, do):\n",
        "        memo = {}; stack = set()\n",
        "        def val(v):\n",
        "            if v in do: return do[v]\n",
        "            if v in roots_val: return roots_val[v]\n",
        "            if v in memo: return memo[v]\n",
        "            if v in stack: return False\n",
        "            stack.add(v); r = False\n",
        "            for dnf, neg in eqs[v]:\n",
        "                x = any(all(val(a) != n for a, n in conj) for conj in dnf)\n",
        "                r = r or (not x if neg else x)\n",
        "            stack.discard(v); memo[v] = r; return r\n",
        "        return val\n",
        "\n",
        "    do = {v: (not n) for v, n in do_l}\n",
        "    default = {r: False for r in roots}\n",
        "    for v, n in obs + fact:\n",
        "        if v in default and not n: default[v] = True\n",
        "    for v, val in do.items():\n",
        "        if v in default and v not in {a for a, _ in obs}: default[v] = not val\n",
        "    cands = []\n",
        "    for bits in itertools.product([False, True], repeat=len(roots)) if len(roots) <= 14 else [tuple(default[r] for r in roots)]:\n",
        "        rv = dict(zip(roots, bits)); fv = make_eval(rv, {})\n",
        "        if all(fv(v) != n for v, n in obs + fact):\n",
        "            cands.append(rv)\n",
        "    if not cands: cands = [default]\n",
        "    def dist(rv): return sum(rv[r] != default[r] for r in roots)\n",
        "    best = min(dist(c) for c in cands); cands = [c for c in cands if dist(c) == best]\n",
        "    answers = [make_eval(c, do)(target[0]) != target[1] for c in cands]\n",
        "    ans = sum(answers) * 2 > len(answers)\n",
        "    tr = \"\"\n",
        "    if trace:\n",
        "        c = cands[0]; ev = make_eval(c, do); fv = make_eval(c, {})\n",
        "        tr += f\"exogenous roots (abduced): { {r: int(c[r]) for r in roots} }\\n\"\n",
        "        tr += f\"intervention do({ {v: int(x) for v, x in do.items()} })\\n\"\n",
        "        order = [n for n in sorted(names)]\n",
        "        tr += \"factual : \" + \", \".join(f\"{n}={int(fv(n))}\" for n in order) + \"\\n\"\n",
        "        tr += \"counterf.: \" + \", \".join(f\"{n}={int(ev(n))}\" for n in order) + \"\\n\"\n",
        "        tr += f\"target {'not ' if target[1] else ''}{target[0]} -> {'yes' if ans else 'no'}\\n\"\n",
        "    return ans, tr\n",
        "\n",
        "def cb_predict(context, question=\"\", trace=False):\n",
        "    try:\n",
        "        ctx = (context or \"\").strip()\n",
        "        if ctx and ctx[-1] not in \".?!\": ctx += \".\"\n",
        "        P = cb_parse(ctx + \" \" + (question or \"\"))\n",
        "        ans, tr = cb_solve(P, trace)\n",
        "    except Exception as e:\n",
        "        ans, tr = False, f\"error: {e}\"\n",
        "    return (ans, tr) if trace else ans\n"
      ]
    },
