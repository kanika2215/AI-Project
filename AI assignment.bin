      "source": [
        "## Forward-chaining engine"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "id": "04f4d686",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-11-03T13:42:07.191710Z",
          "iopub.status.busy": "2026-11-03T13:42:07.191555Z",
          "iopub.status.idle": "2026-11-03T13:42:07.204722Z",
          "shell.execute_reply": "2026-11-03T13:42:07.204070Z"
        },
        "id": "04f4d686"
      },
      "outputs": [],
      "source": [
        "class Closure:\n",
        "    def __init__(self): self.pos = defaultdict(set); self.neg = defaultdict(set); self.prov = {}; self.mode = \"cwa\"\n",
        "    def has(self, l): return l.args in (self.neg if l.neg else self.pos).get(l.pred, ())\n",
        "\n",
        "def constants_of(rules):\n",
        "    return {a for r in rules for l in (*r.body, r.head) for a in l.args if not is_var(a) and not isinstance(a, tuple)}\n",
        "\n",
        "def detect_mode(rules):\n",
        "    return \"owa\" if any(r.head.neg for r in rules) else \"cwa\"\n",
        "\n",
        "def _stratify(rules):\n",
        "    lvl = defaultdict(int); preds = {l.pred for r in rules for l in (*r.body, r.head)}\n",
        "    for _ in range(len(preds) + 2):\n",
        "        ch = False\n",
        "        for r in rules:\n",
        "            for b in r.body:\n",
        "                need = lvl[b.pred] + (1 if b.neg else 0)\n",
        "                if lvl[r.head.pred] < need: lvl[r.head.pred] = need; ch = True\n",
        "        if not ch: return lvl\n",
        "    return None\n",
        "\n",
        "def forward_chain(rules, mode=None, domain=None):\n",
        "    mode = mode or detect_mode(rules)\n",
        "    C = Closure()\n",
        "    C.mode = mode\n",
        "    domain = sorted(domain if domain is not None else constants_of(rules))\n",
        "\n",
        "    ground = lambda lit: all(not is_var(a) for a in lit.args)\n",
        "    facts = [r for r in rules if not r.body and ground(r.head)]\n",
        "    prules = [r for r in rules if r.body or not ground(r.head)]\n",
        "    def add(l, why):\n",
        "        st = C.neg if l.neg else C.pos\n",
        "        if l.args in st[l.pred]:\n",
        "            return False\n",
        "        st[l.pred].add(l.args)\n",
        "        C.prov[l] = why\n",
        "        return True\n",
        "\n",
        "    for f in facts:\n",
        "        add(f.head, (\"fact\", f.text))\n",
        "\n",
        "    def naf(l):\n",
        "        return mode == \"cwa\" and l.neg\n",
        "\n",
        "    def match(l, theta):\n",
        "        st = C.neg if (l.neg and mode == \"owa\") else C.pos\n",
        "        for fa in list(st.get(l.pred, ())):\n",
        "            if len(fa) != len(l.args):\n",
        "                continue\n",
        "            t = dict(theta)\n",
        "            ok = True\n",
        "            for a, f in zip(l.args, fa):\n",
        "                if is_var(a):\n",
        "                    if t.setdefault(a, f) != f:\n",
        "                        ok = False\n",
        "                        break\n",
        "                elif a != f:\n",
        "                    ok = False\n",
        "                    break\n",
        "            if ok:\n",
        "                yield t\n",
        "\n",
        "    def apply_rule(r):\n",
        "        join = [b for b in r.body if not naf(b)]\n",
        "        nafs = [b for b in r.body if naf(b)]\n",
        "        join.sort(key=lambda b: -sum(not is_var(a) for a in b.args))\n",
        "        out = []\n",
        "\n",
        "        def rec(i, th):\n",
        "            if i == len(join):\n",
        "                free = sorted({\n",
        "                    a for l in (*nafs, r.head)\n",
        "                    for a in l.args\n",
        "                    if is_var(a) and a not in th\n",
        "                })\n",
        "\n",
        "                for vals in itertools.product(domain, repeat=len(free)):\n",
        "                    t = {**th, **dict(zip(free, vals))}\n",
        "\n",
        "                    g = lambda l: Lit(\n",
        "                        l.neg, l.pred,\n",
        "                        tuple(t.get(a, a) for a in l.args)\n",
        "                    )\n",
        "\n",
        "                    if any(\n",
        "                        g(n).args in C.pos.get(n.pred, ())\n",
        "                        for n in nafs\n",
        "                    ):\n",
        "                        continue\n",
        "\n",
        "                    out.append((\n",
        "                        g(r.head),\n",
        "                        (\"rule\", r, [g(b) for b in r.body])\n",
        "                    ))\n",
        "                return\n",
        "\n",
        "            for t in match(join[i], th):\n",
        "                rec(i + 1, t)\n",
        "\n",
        "        rec(0, {})\n",
        "        return out\n",
        "\n",
        "    lv = (\n",
        "        _stratify(prules)\n",
        "        if mode == \"cwa\" and any(\n",
        "            b.neg for r in prules for b in r.body\n",
        "        )\n",
        "        else defaultdict(int)\n",
        "    )\n",
        "\n",
        "    groups = defaultdict(list)\n",
        "\n",
        "    for r in prules:\n",
        "        groups[(lv or {}).get(r.head.pred, 0)].append(r)\n",
        "\n",
        "    for _, grp in sorted(groups.items()):\n",
        "        bpreds = {\n",
        "            id(r): {b.pred for b in r.body}\n",
        "            for r in grp\n",
        "        }\n",
        "\n",
        "        changed = None\n",
        "\n",
        "        while changed is None or changed:\n",
        "            new = set()\n",
        "\n",
        "            for r in grp:\n",
        "                if changed is not None and not (\n",
        "                    bpreds[id(r)] & changed\n",
        "                ):\n",
        "                    continue\n",
        "\n",
        "                for h, why in apply_rule(r):\n",
        "                    if add(h, why):\n",
        "                        new.add(h.pred)\n",
        "\n",
        "            changed = new\n",
        "\n",
        "    return C\n",
        "\n",
        "def holds(l, C):\n",
        "    \"\"\"Truth of a literal in the closure.\"\"\"\n",
        "    if C.mode == \"cwa\":\n",
        "        return (l.args not in C.pos.get(l.pred, ())) if l.neg else (l.args in C.pos.get(l.pred, ()))\n",
        "\n",
        "    if C.has(l):\n",
        "        return True\n",
        "    if C.has(neg_lit(l)):\n",
        "        return False\n",
        "    return None\n",
        "\n",
        "def explain(l, C, depth=0, seen=None):\n",
        "    \"\"\"Reasoning trace (proof tree) for a derived literal.\"\"\"\n",
        "    seen = seen or set(); pad = \"  \" * depth\n",
        "    why = C.prov.get(l)\n",
        "    if why is None:\n",
        "        return f\"{pad}{lit_str(l)}   [not derivable]\\n\"\n",
        "    if why[0] == \"fact\": return f\"{pad}{lit_str(l)}   [fact]\\n\"\n",
        "    _, r, prem = why\n",
        "    s = f\"{pad}{lit_str(l)}   [by {rule_str(r)}]\\n\"\n",
        "    if l in seen: return s\n",
        "    seen = seen | {l}\n",
        "    for p in prem:\n",
        "        s += explain(p, C, depth + 1, seen) if p in C.prov else f\"{pad}  not {lit_str(neg_lit(p))}   [negation as failure]\\n\" if p.neg else f\"{pad}  {lit_str(p)}\\n\"\n",
        "    return s\n"
      ]
    },
