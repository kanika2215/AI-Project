      "source": [
        "## First-order logic and resolution"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "id": "b6f8d610",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-11-03T13:42:07.206576Z",
          "iopub.status.busy": "2026-11-03T13:42:07.206461Z",
          "iopub.status.idle": "2026-11-03T13:42:07.234523Z",
          "shell.execute_reply": "2026-11-03T13:42:07.233881Z"
