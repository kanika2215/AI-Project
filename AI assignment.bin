      "source": [
        "import time\n",
        "from collections import Counter\n",
        "\n",
        "def folio_gold_eval(rows, tlimit=3.0, show=12):\n",
        "    t0 = time.perf_counter(); preds = []; cache = {}\n",
        "    for r in rows:\n",
        "        key = tuple(r[\"premises_fol\"])\n",
        "        try:\n",
        "            if key not in cache:\n",
        "                cache[key] = [c for p in f2_parse_many(key) for c in f2_clauses(p)]\n",
        "            ax = cache[key]; C = f2_parse(r[\"conclusion_fol\"])\n",
        "            if   f2_refute(ax, f2_clauses((\"not\", C)), tlimit=tlimit) is True: lab = \"True\"\n",
        "            elif f2_refute(ax, f2_clauses(C),          tlimit=tlimit) is True: lab = \"False\"\n",
        "            else: lab = \"Uncertain\"\n",
        "        except Exception:\n",
        "            lab = \"Uncertain\"\n",
        "        preds.append(lab)\n",
        "    dt = time.perf_counter() - t0\n",
        "    gold = [r[\"label\"] for r in rows]; n = len(rows)\n",
        "    acc3 = 100 * sum(p == g for p, g in zip(preds, gold)) / n\n",
        "    acc2 = 100 * sum((p == \"True\") == (g == \"True\") for p, g in zip(preds, gold)) / n\n",
        "    print(f\"examples={n}  inference time={dt:.2f}s\")\n",
        "    print(f\"3-class accuracy (True/False/Uncertain): {acc3:.2f}%\")\n",
        "    print(f\"binary accuracy  (entailed vs not)     : {acc2:.2f}%\")\n",
        "    cm = Counter(zip(gold, preds)); cls = [\"True\", \"False\", \"Uncertain\"]\n",
        "    print(\"rows=gold, cols=pred\", cls)\n",
        "    for g in cls: print(f\"  {g:10s}\", [cm[(g, p)] for p in cls])\n",
        "    wrong = [i for i, (p, g) in enumerate(zip(preds, gold)) if p != g]\n",
        "    print(\"mismatching example indices:\", wrong[:show], \"...\" if len(wrong) > show else \"\")\n",
        "    return {\"preds\": preds, \"acc3\": acc3, \"acc2\": acc2, \"time\": dt, \"wrong\": wrong}\n",
        "\n",
        "print(\"=\" * 78)\n",
        "print(\"ORACLE EVALUATION: uses FOLIO's gold FOL annotations (not available for the private test set).\")\n",
        "print(\"It measures the classical reasoning engine only, NOT natural-language understanding.\")\n",
        "print(\"=\" * 78)\n",
        "FOLIO_RESULTS = {}\n",
        "for name, rows in FOLIO_GOLD.items():\n",
        "    print(\"\\n##\", name); FOLIO_RESULTS[name] = folio_gold_eval(rows)\n"
      ]
    },
