      ],
      "source": [
        "from collections import Counter, defaultdict\n",
        "import time\n",
        "\n",
        "folio_cache = {}\n",
        "\n",
        "def predict_folio(context, question):\n",
        "\n",
        "    if context not in folio_cache:\n",
        "        rules, bad = parse_context(context)\n",
        "\n",
        "        closure = forward_chain(rules, mode=\"owa\")\n",
        "\n",
        "        folio_cache[context] = (closure, bad)\n",
        "\n",
        "    closure, bad = folio_cache[context]\n",
        "\n",
        "    try:\n",
        "        mode, literals = parse_query(question)\n",
        "        values = [holds(lit, closure) for lit in literals]\n",
        "\n",
        "    except (ValueError, IndexError):\n",
        "        return \"Uncertain\"\n",
        "\n",
        "    if not values:\n",
        "        return \"Uncertain\"\n",
        "\n",
        "    if mode == \"and\":\n",
        "        if False in values:\n",
        "            return \"False\"\n",
        "        elif all(v is True for v in values):\n",
        "            return \"True\"\n",
        "        else:\n",
        "            return \"Uncertain\"\n",
        "\n",
        "    else:\n",
        "        if True in values:\n",
        "            return \"True\"\n",
        "        elif all(v is False for v in values):\n",
        "            return \"False\"\n",
        "        else:\n",
        "            return \"Uncertain\"\n",
        "\n",
        "def evaluate_folio(rows, show_errors=15):\n",
        "\n",
        "    start = time.perf_counter()\n",
        "\n",
        "    predictions = [\n",
        "        predict_folio(row[\"context\"], row[\"question\"])\n",
        "        for row in rows\n",
        "    ]\n",
        "\n",
        "    elapsed = time.perf_counter() - start\n",
        "\n",
        "    actual = [\n",
        "        str(row[\"label\"]).strip().capitalize()\n",
        "        for row in rows\n",
        "    ]\n",
        "\n",
        "    classes = [\"True\", \"False\", \"Uncertain\"]\n",
        "\n",
        "    correct = sum(\n",
        "        p == a for p, a in zip(predictions, actual)\n",
        "    )\n",
        "\n",
        "    accuracy = 100 * correct / len(rows)\n",
        "\n",
        "    print(\"\\n========== FOLIO EVALUATION ==========\")\n",
        "    print(\"Examples:\", len(rows))\n",
        "    print(f\"Inference time: {elapsed:.3f} seconds\")\n",
        "    print(f\"Accuracy: {accuracy:.2f}%\")\n",
        "\n",
        "    print(\"\\n--- Label Distribution ---\")\n",
        "    print(\"Actual:\", dict(Counter(actual)))\n",
        "    print(\"Predicted:\", dict(Counter(predictions)))\n",
        "\n",
        "    print(\"\\n--- Confusion Matrix ---\")\n",
        "    print(\"Rows = Actual | Columns = Predicted\")\n",
        "    print(f\"{'':12s}\" + \"\".join(f\"{c:12s}\" for c in classes))\n",
        "\n",
        "    for a in classes:\n",
        "        row_values = [\n",
        "            sum(\n",
        "                actual[i] == a and predictions[i] == p\n",
        "                for i in range(len(rows))\n",
        "            )\n",
        "            for p in classes\n",
        "        ]\n",
        "        print(f\"{a:12s}\" + \"\".join(f\"{v:<12d}\" for v in row_values))\n",
        "\n",
        "    print(\"\\n--- Class-wise Accuracy ---\")\n",
        "\n",
        "    for c in classes:\n",
        "        indices = [\n",
        "            i for i, label in enumerate(actual)\n",
        "            if label == c\n",
        "        ]\n",
        "\n",
        "        if indices:\n",
        "            score = sum(\n",
        "                predictions[i] == actual[i]\n",
        "                for i in indices\n",
        "            ) / len(indices) * 100\n",
        "\n",
        "            print(f\"{c}: {score:.2f}% ({len(indices)} examples)\")\n",
        "\n",
        "    errors = []\n",
        "\n",
        "    for i, (row, pred, gold) in enumerate(\n",
        "        zip(rows, predictions, actual)\n",
        "    ):\n",
        "        if pred != gold:\n",
        "            errors.append({\n",
        "                \"id\": row.get(\"id\"),\n",
        "                \"context\": row[\"context\"],\n",
        "                \"question\": row[\"question\"],\n",
        "                \"actual\": gold,\n",
        "                \"predicted\": pred\n",
        "            })\n",
        "\n",
        "    print(\"\\n--- Incorrect Predictions ---\")\n",
        "    print(\"Total errors:\", len(errors))\n",
        "\n",
        "    for i, error in enumerate(errors[:show_errors], 1):\n",
        "        print(f\"\\nError {i} | ID: {error['id']}\")\n",
        "        print(\"Question:\", error[\"question\"])\n",
        "        print(\"Actual:\", error[\"actual\"])\n",
        "        print(\"Predicted:\", error[\"predicted\"])\n",
        "        print(\"Context:\", error[\"context\"][:400])\n",
        "\n",
        "    return {\n",
        "        \"predictions\": predictions,\n",
        "        \"actual\": actual,\n",
        "        \"accuracy\": accuracy,\n",
        "        \"errors\": errors,\n",
        "        \"error_count\": len(errors),\n",
        "        \"time\": elapsed\n",
        "    }\n",
        "\n",
        "if folio_rows:\n",
        "    folio_result = evaluate_folio(folio_rows, show_errors=5)\n",
        "else:\n",
        "    print(\"FOLIO rows not loaded - skipping the natural-language baseline.\")\n"
      ]
    },
