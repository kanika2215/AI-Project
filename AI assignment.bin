      "outputs": [],
      "source": [
        "_KB_CACHE = {}\n",
        "FORCE_MODE  = None\n",
        "UNKNOWN_AS  = False\n",
        "TRANSLATOR  = None\n",
        "\n",
        "def _looks_fol(*texts): return any(c in t for t in texts for c in \"∀∃\")\n",
        "\n",
        "def predict(context, question, return_trace=False):\n",
        "    trace = \"\"\n",
        "    try:\n",
        "        if _looks_fol(context, question):\n",
        "            prem = [p.strip() for p in re.split(r\"\\n+\", context) if p.strip()]\n",
        "            return fol_entails(prem, question)\n",
        "        if TRANSLATOR is not None and not re.search(r\"\\b(if|is|are)\\b\", context.lower()):\n",
        "            prem, concl = TRANSLATOR(context, question); return fol_entails(prem, concl)\n",
        "        key = (context, FORCE_MODE)\n",
        "        if key not in _KB_CACHE:\n",
        "            rules, bad = parse_context(context)\n",
        "            C = forward_chain(rules, FORCE_MODE)\n",
        "            if len(_KB_CACHE) > 5000: _KB_CACHE.clear()\n",
        "            _KB_CACHE[key] = (rules, C)\n",
        "        rules, C = _KB_CACHE[key]\n",
        "        mode, lits = parse_query(question)\n",
        "        vals = [holds(l, C) for l in lits]\n",
        "        vals = [UNKNOWN_AS if v is None else v for v in vals]\n",
        "        ans = any(vals) if mode == \"or\" else all(vals)\n",
        "        if return_trace: trace = \"\".join(explain(l, C) for l in lits)\n",
        "        return (ans, trace) if return_trace else ans\n",
        "    except Exception as e:\n",
        "        return (UNKNOWN_AS, f\"error: {e}\") if return_trace else UNKNOWN_AS\n",
        "\n",
        "def norm_label(label):\n",
        "    \"\"\"True / False for RuleTaker, FOLIO (entailed or not) and CounterBench (yes / no).\"\"\"\n",
        "    label = str(label).strip().lower()\n",
        "    if label in {\"entailment\", \"true\", \"1\", \"yes\", \"entailed\"}:\n",
        "        return True\n",
        "    if label in {\"not entailment\", \"not_entailment\", \"non-entailment\", \"contradiction\",\n",
        "                 \"false\", \"0\", \"no\", \"uncertain\", \"unknown\"}:\n",
        "        return False\n",
        "    raise ValueError(f\"Unknown label: {label}\")\n",
        "\n",
        "def looks_counterbench(context, question):\n",
        "    t = (context or \"\") + \" \" + (question or \"\")\n",
        "    return bool(re.search(r\"\\bcauses?\\b\", t, re.I) and re.search(r\"\\b(would|assume|suppose)\\b\", t, re.I)\n",
        "                and re.search(r\"\\boccur\\b\", t, re.I))\n",
        "\n",
        "def predict_any(context, question):\n",
        "    \"\"\"Route an instance to the matching classical engine.\"\"\"\n",
        "    if looks_counterbench(context, question):\n",
        "        return cb_predict(context, question)\n",
        "    return predict(context, question)\n"
      ]
    },
