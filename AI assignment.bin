      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "RULE REASONING (closed world / negation as failure):\n",
            "OK  | Bob is successful. | expected True | got True\n",
            "OK  | Bob is rich. | expected False | got False\n",
            "OK  | Bob is red. | expected True | got True\n",
            "OK  | Anne is red. | expected False | got False\n",
            "\n",
            "RULE REASONING (strong negation, open world):\n",
            "OK  | Charlie is not nice. | expected True | got True\n",
            "OK  | Charlie is kind. | expected True | got True\n",
            "\n",
            "PARSER REGRESSION:\n",
            "OK  | Rex is an animal. | expected True | got True\n",
            "OK  | Rex is friendly. | expected True | got True\n",
            "OK  | Alice likes Carol. | expected True | got True\n",
            "OK  | Bob is kind. | expected True | got True\n",
            "OK  | A is green. | expected True | got True\n",
            "OK  | Anne is red. | expected True | got True\n",
            "OK  | The tiger is cold. | expected True | got True\n",
            "OK  | Erin is young. | expected True | got True\n",
            "OK  | Sam will not use a Mac. | expected True | got True\n",
            "parse_conj: [Lit(neg=False, pred='widespread_over_africa', args=('elephantopus',)), Lit(neg=False, pred='asia', args=('elephantopus',)), Lit(neg=False, pred='australia', args=('elephantopus',))]\n",
            "\n",
            "FIRST-ORDER LOGIC (resolution + unification):\n",
            "Mortal(rex): True | Cat(rex): Uncertain\n",
            "\n",
            "COUNTERFACTUAL (structural causal model):\n",
            "OK  | Would Lumbo occur if not Ziklo instead of Ziklo? | expected False | got False\n",
            "OK  | Would Lumbo occur if not Ziklo instead of Ziklo? | expected True | got True\n",
            "OK  | Would Y occur if not X and not V3? | expected False | got False\n"
          ]
        }
      ],
      "source": [
        "_KB_CACHE.clear()\n",
        "\n",
        "def check(context, question, expected):\n",
        "    got = predict(context, question)\n",
        "    print(f\"{'OK ' if got == expected else 'BAD'} | {question} | expected {expected} | got {got}\")\n",
        "\n",
        "print(\"RULE REASONING (closed world / negation as failure):\")\n",
        "ex = (\"Bob is young. Bob is kind. If someone is young, then they are smart. \"\n",
        "      \"If someone is smart and kind, then they are successful.\")\n",
        "check(ex, \"Bob is successful.\", True)\n",
        "check(ex, \"Bob is rich.\", False)\n",
        "c = \"Anne is big. Bob is nice. If someone is not big then they are red. Big, nice things are green.\"\n",
        "check(c, \"Bob is red.\", True)\n",
        "check(c, \"Anne is red.\", False)\n",
        "\n",
        "print(\"\\nRULE REASONING (strong negation, open world):\")\n",
        "FORCE_MODE = None\n",
        "c = \"Charlie is big. Charlie is not red. If someone is big then they are not nice. Everyone is kind.\"\n",
        "check(c, \"Charlie is not nice.\", True)\n",
        "check(c, \"Charlie is kind.\", True)\n",
        "\n",
        "def parser_check(context, question, expected):\n",
        "    try:\n",
        "        rules, bad = parse_context(context)\n",
        "        closure = forward_chain(rules, FORCE_MODE)\n",
        "        mode, literals = parse_query(question)\n",
        "        values = [holds(lit, closure) for lit in literals]\n",
        "        values = [UNKNOWN_AS if v is None else v for v in values]\n",
        "        result = any(values) if mode == \"or\" else all(values)\n",
        "        ok = (result == expected) and not bad\n",
        "        print(f\"{'OK ' if ok else 'BAD'} | {question} | expected {expected} | got {result}\" + (f\" | parser errors: {bad}\" if bad else \"\"))\n",
        "    except Exception as e:\n",
        "        print(f\"BAD | {question} | {e!r}\")\n",
        "\n",
        "print(\"\\nPARSER REGRESSION:\")\n",
        "parser_check(\"Rex is a dog. All dogs are animals.\", \"Rex is an animal.\", True)\n",
        "parser_check(\"Rex is a big dog. All big dogs are friendly.\", \"Rex is friendly.\", True)\n",
        "parser_check(\"Alice likes Bob and Carol.\", \"Alice likes Carol.\", True)\n",
        "parser_check(\"Bob is young and kind.\", \"Bob is kind.\", True)\n",
        "parser_check(\"Big, nice things are green. A is big. A is nice.\", \"A is green.\", True)\n",
        "parser_check(\"Anne is furry. Anne is round. All furry, round people are red.\", \"Anne is red.\", True)\n",
        "parser_check(\"The tiger is green. All green things are cold.\", \"The tiger is cold.\", True)\n",
        "parser_check(\"Erin is nice. If someone is rough or nice then they are young.\", \"Erin is young.\", True)\n",
        "parser_check(\"If Sam does a project written in Python, he will not use a Mac. Sam does a project written in Python.\",\n",
        "             \"Sam will not use a Mac.\", True)\n",
        "print(\"parse_conj:\", parse_conj(tokenize(\"Elephantopus is widespread over Africa, Asia and Australia\"), Ctx()))\n",
        "\n",
        "print(\"\\nFIRST-ORDER LOGIC (resolution + unification):\")\n",
        "prem = [\"∀x (Dog(x) → Animal(x))\", \"∀x (Animal(x) → Mortal(x))\", \"Dog(rex)\"]\n",
        "print(\"Mortal(rex):\", fol_entails(prem, \"Mortal(rex)\", three_way=True), \"| Cat(rex):\", fol_entails(prem, \"Cat(rex)\", three_way=True))\n",
        "\n",
        "print(\"\\nCOUNTERFACTUAL (structural causal model):\")\n",
        "for g, q, a in [(\"We know that Ziklo causes Blaf, Blaf causes Trune, Trune causes Vork, and Vork causes Lumbo.\",\n",
        "                 \"Would Lumbo occur if not Ziklo instead of Ziklo?\", False),\n",
        "                (\"We know that Ziklo causes not Blaf, Blaf and Trune together cause Vork, Vork causes Lumbo. We observed Trune\",\n",
        "                 \"Would Lumbo occur if not Ziklo instead of Ziklo?\", True),\n",
        "                (\"We know that X causes V1, V1 causes V2, V2 and V1 together cause V3, V3 causes V4, V4 and X together cause V5, and V5 causes Y.\",\n",
        "                 \"Would Y occur if not X and not V3?\", False)]:\n",
        "    got = predict_any(g, q); print(f\"{'OK ' if got == a else 'BAD'} | {q} | expected {a} | got {got}\")\n"
      ]
    },
    {
