      "source": [
        "def _g(name, key=None):\n",
        "    v = globals().get(name)\n",
        "    if v is None: return None\n",
        "    return v if key is None else (v.get(key) if isinstance(v, dict) else None)\n",
        "rows_ = []\n",
        "rows_.append((\"RuleTaker  - NL -> forward chaining (public dev)\", _g(\"rt_result\", \"accuracy\"), \"needs the RuleTaker download\"))\n",
        "rows_.append((\"FOLIO      - NL-only pipeline, 3-class\", _g(\"folio_result\", \"accuracy\"), \"end-to-end, hand-written parser\"))\n",
        "bin_nl = None\n",
        "if _g(\"folio_result\") is not None:\n",
        "    pr, ac = folio_result[\"predictions\"], folio_result[\"actual\"]\n",
        "    bin_nl = 100 * sum((p == \"True\") == (a == \"True\") for p, a in zip(pr, ac)) / len(ac)\n",
        "rows_.append((\"FOLIO      - NL-only pipeline, binary\", bin_nl, \"end-to-end, hand-written parser\"))\n",
        "g3 = next(iter(FOLIO_RESULTS.values()))[\"acc3\"] if globals().get(\"FOLIO_RESULTS\") else None\n",
        "g2 = next(iter(FOLIO_RESULTS.values()))[\"acc2\"] if globals().get(\"FOLIO_RESULTS\") else None\n",
        "rows_.append((\"FOLIO      - resolution engine on GOLD FOL, 3-class\", g3, \"ORACLE (logical form given)\"))\n",
        "rows_.append((\"FOLIO      - resolution engine on GOLD FOL, binary\", g2, \"ORACLE (logical form given)\"))\n",
        "rows_.append((\"FOLIO      - NL -> LLM -> FOL -> resolution, 3-class\", _g(\"None\", \"acc3\"), \"optional, needs API key\"))\n",
        "rows_.append((\"CounterBench - real rows (HF or embedded sample)\", _g(\"CB_RESULT\", \"accuracy\"), f\"n={len(CB_ROWS)}\"))\n",
        "rows_.append((\"CounterBench - synthetic stress test\", _g(\"None\", \"overall\"), \"generated, consistency check\"))\n",
        "print(f\"{'Experiment':58s} {'Accuracy':>9s}   Note\")\n",
        "print(\"-\" * 100)\n",
        "for name, acc, note in rows_:\n",
        "    print(f\"{name:58s} {('%.2f%%' % acc) if acc is not None else 'not run':>9s}   {note}\")\n"
      ]
    },
