      },
      "source": [
        "## Natural-language parser"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "id": "ea466a89",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-11-03T13:42:07.154510Z",
          "iopub.status.busy": "2026-11-03T13:42:07.154396Z",
          "iopub.status.idle": "2026-11-03T13:42:07.190294Z",
          "shell.execute_reply": "2026-11-03T13:42:07.189450Z"
        },
        "id": "ea466a89"
      },
      "outputs": [],
      "source": [
        "import re\n",
        "import itertools\n",
        "from collections import defaultdict\n",
        "\n",
        "GENERIC = {\"someone\",\"something\",\"everyone\",\"everything\",\"anyone\",\"anything\",\n",
        "           \"somebody\",\"everybody\",\"anybody\"}\n",
        "PRONOUNS = {\"it\",\"they\",\"them\",\"he\",\"she\",\"him\",\"her\"}\n",
        "DETS = {\"the\",\"a\",\"an\"}\n",
        "GEN_NOUNS = {\"thing\",\"things\",\"person\",\"people\",\"persons\",\"one\",\"ones\",\n",
        "             \"individual\",\"individuals\"}\n",
        "QUANT = {\"all\",\"every\",\"each\",\"any\"}\n",
        "PREPOSITIONS = {\"of\",\"in\",\"over\",\"from\",\"at\",\"to\",\"by\",\"with\",\"for\",\"on\",\"about\",\"across\",\"through\",\"throughout\"}\n",
        "COPULAS = {\"is\",\"are\",\"was\",\"were\"}\n",
        "AUX = {\"is\",\"are\",\"was\",\"were\",\"does\",\"do\",\"did\",\"will\",\"would\",\"can\",\"could\",\"should\",\"must\",\"may\",\"might\"}\n",
        "VERBS = set(\"\"\"like need chase eat see visit love hate hit kill push touch follow help know want have own sell buy\n",
        "give call admire respect fear scare watch meet carry hug kiss lick bite teach tell take make find use\n",
        "praise trust hear smell grab throw catch lead join play receive do\"\"\".split())\n",
        "\n",
        "def singular_noun(w):\n",
        "    irregular = {\"people\": \"person\", \"men\": \"man\", \"women\": \"woman\", \"children\": \"child\", \"mice\": \"mouse\"}\n",
        "    if w in irregular: return irregular[w]\n",
        "    if w.endswith(\"ies\") and len(w) > 4: return w[:-3] + \"y\"\n",
        "    if w.endswith(\"s\") and not w.endswith((\"ss\", \"us\", \"is\")) and len(w) > 3: return w[:-1]\n",
        "    return w\n",
        "\n",
        "def vbase(w):\n",
        "    if w == \"has\": return \"have\"\n",
        "    if w.endswith((\"ches\",\"shes\",\"sses\",\"xes\",\"zes\")): return w[:-2]\n",
        "    if w.endswith(\"ies\") and len(w) > 4: return w[:-3] + \"y\"\n",
        "    if w.endswith(\"s\") and not w.endswith(\"ss\"): return w[:-1]\n",
        "    return w\n",
        "\n",
        "def tokenize(s):\n",
        "    s = s.lower().replace(\"n't\", \" not\")\n",
        "    return re.findall(r\"\\(|\\)|[a-z0-9_-]+|,\", s)\n",
        "\n",
        "def split_on(toks, seps):\n",
        "    parts, cur = [], []\n",
        "    for t in toks:\n",
        "        if t in seps:\n",
        "            if cur: parts.append(cur)\n",
        "            cur = []\n",
        "        else:\n",
        "            cur.append(t)\n",
        "    if cur: parts.append(cur)\n",
        "    return parts\n",
        "\n",
        "def learn_verbs(text):\n",
        "\n",
        "    VERBS.update({\n",
        "        \"do\", \"have\", \"use\"\n",
        "    })\n",
        "\n",
        "    t = text.lower().replace(\"n't\", \" not\")\n",
        "\n",
        "    for m in re.finditer(\n",
        "        r\"\\b(?:does|do|did) not ([a-z]+)\\b\", t\n",
        "    ):\n",
        "        VERBS.add(vbase(m.group(1)))\n",
        "\n",
        "class Ctx:\n",
        "    def __init__(self):\n",
        "        self.first = None\n",
        "        self.last = None\n",
        "        self.n = 0\n",
        "    def newvar(self):\n",
        "        self.n += 1\n",
        "        return f\"?x{self.n}\"\n",
        "    def set_subj(self, s):\n",
        "        if self.first is None: self.first = s\n",
        "        self.last = s\n",
        "    def get_pron(self):\n",
        "        if self.first is None: self.set_subj(self.newvar())\n",
        "        return self.first\n",
        "    def get_subj(self):\n",
        "        if self.last is None: self.set_subj(self.newvar())\n",
        "        return self.last\n",
        "\n",
        "def mk_term(toks, ctx, role):\n",
        "    toks = list(toks)\n",
        "\n",
        "    while toks and toks[0] in DETS:\n",
        "        toks = toks[1:]\n",
        "\n",
        "    s = \" \".join(toks)\n",
        "\n",
        "    if s in PRONOUNS:\n",
        "        return ctx.get_pron()\n",
        "\n",
        "    if s in GENERIC:\n",
        "        if role == \"subj\":\n",
        "            term = ctx.newvar()\n",
        "            ctx.first = term\n",
        "            ctx.last = term\n",
        "            return term\n",
        "        return ctx.newvar()\n",
        "\n",
        "    return s\n",
        "\n",
        "def pred_start(toks):\n",
        "    for i, t in enumerate(toks):\n",
        "        if t in AUX:\n",
        "            return i\n",
        "\n",
        "        if t not in DETS and vbase(t) in VERBS:\n",
        "            return i\n",
        "\n",
        "    return None\n",
        "def expand_shared_property(tokens):\n",
        "    \"\"\"\n",
        "    Expand coordinated locations while preserving the shared property.\n",
        "    Example:\n",
        "    widespread over Africa, Asia and Australia\n",
        "    \"\"\"\n",
        "\n",
        "    tokens = list(tokens)\n",
        "\n",
        "    markers = [\"over\", \"in\", \"from\", \"across\", \"throughout\"]\n",
        "\n",
        "    marker_index = None\n",
        "\n",
        "    for i, token in enumerate(tokens):\n",
        "        if token in markers:\n",
        "            marker_index = i\n",
        "            break\n",
        "\n",
        "    if marker_index is None:\n",
        "        return None\n",
        "\n",
        "    prefix = tokens[:marker_index + 1]\n",
        "    locations = tokens[marker_index + 1:]\n",
        "\n",
        "    parts = [\n",
        "        part for part in split_on(locations, {\"and\", \",\"})\n",
        "        if part\n",
        "    ]\n",
        "\n",
        "    if len(parts) <= 1:\n",
        "        return None\n",
        "\n",
        "    return [prefix + part for part in parts]\n",
        "\n",
        "def _unary_predicates(tokens, subject, neg=False):\n",
        "    \"\"\"Convert property phrases into unary predicates.\"\"\"\n",
        "\n",
        "    tokens = list(tokens)\n",
        "    out = []\n",
        "\n",
        "    expanded = expand_shared_property(tokens)\n",
        "\n",
        "    if expanded:\n",
        "        for part in expanded:\n",
        "            p = [\n",
        "                x for x in part\n",
        "                if x not in {\"a\", \"an\", \"the\", \"very\", \"really\"}\n",
        "            ]\n",
        "\n",
        "            if p:\n",
        "                predicate = \"_\".join(\n",
        "                    singular_noun(x) for x in p\n",
        "                )\n",
        "\n",
        "                out.append(Lit(neg, predicate, (subject,)))\n",
        "\n",
        "        return out\n",
        "\n",
        "    for part in split_on(tokens, {\"and\", \",\"}):\n",
        "\n",
        "        p = list(part)\n",
        "\n",
        "        if not p:\n",
        "            continue\n",
        "\n",
        "        n = neg\n",
        "\n",
        "        if p[0] == \"not\":\n",
        "            n = not n\n",
        "            p = p[1:]\n",
        "\n",
        "        had_article = bool(p) and p[0] in {\"a\", \"an\"}\n",
        "\n",
        "        p = [\n",
        "            x for x in p\n",
        "            if x not in {\"a\", \"an\", \"the\", \"very\", \"really\"}\n",
        "        ]\n",
        "\n",
        "        if not p:\n",
        "            continue\n",
        "\n",
        "        if (had_article and not n and len(p) > 1\n",
        "                and not (set(p) & PREPOSITIONS)):\n",
        "\n",
        "            for x in p:\n",
        "                out.append(Lit(False, singular_noun(x), (subject,)))\n",
        "            continue\n",
        "\n",
        "        predicate = \"_\".join(\n",
        "            singular_noun(x) for x in p\n",
        "        )\n",
        "\n",
        "        out.append(Lit(n, predicate, (subject,)))\n",
        "\n",
        "    return out\n",
        "def parse_clause(toks, ctx):\n",
        "    toks = [\n",
        "        t for t in toks\n",
        "        if t not in {\"(\", \")\"}\n",
        "    ]\n",
        "\n",
        "    if not toks:\n",
        "        return []\n",
        "\n",
        "    while toks and toks[0] == \",\":\n",
        "        toks.pop(0)\n",
        "\n",
        "    if not toks:\n",
        "        return []\n",
        "\n",
        "    k = pred_start(toks)\n",
        "\n",
        "    if k is None:\n",
        "        neg = toks[0] == \"not\"\n",
        "        rest = toks[1:] if neg else toks\n",
        "\n",
        "        if not rest:\n",
        "            raise ValueError(\"Empty predicate\")\n",
        "\n",
        "        return [\n",
        "            Lit(\n",
        "                neg,\n",
        "                \"_\".join(x for x in rest if x not in DETS),\n",
        "                (ctx.get_subj(),)\n",
        "            )\n",
        "        ]\n",
        "\n",
        "    subj_t, rest = toks[:k], toks[k:]\n",
        "\n",
        "    if subj_t:\n",
        "        subject = mk_term(subj_t, ctx, \"subj\")\n",
        "        ctx.set_subj(subject)\n",
        "    else:\n",
        "        subject = ctx.get_subj()\n",
        "\n",
        "    while rest and rest[0] == \",\":\n",
        "        rest.pop(0)\n",
        "\n",
        "    if not rest:\n",
        "        return []\n",
        "\n",
        "    verb_word = rest[0]\n",
        "\n",
        "    if verb_word in COPULAS:\n",
        "        tail = rest[1:]\n",
        "        neg = bool(tail and tail[0] == \"not\")\n",
        "        if neg:\n",
        "            tail = tail[1:]\n",
        "        if not tail:\n",
        "            raise ValueError(\"Missing predicate after copula\")\n",
        "        return _unary_predicates(tail, subject, neg)\n",
        "\n",
        "    if verb_word in (\"does\", \"do\", \"did\"):\n",
        "      tail = rest[1:]\n",
        "\n",
        "      if tail and tail[0] in DETS:\n",
        "        verb = \"do\"\n",
        "        obj = tail\n",
        "        neg = False\n",
        "\n",
        "      else:\n",
        "        neg = bool(tail and tail[0] == \"not\")\n",
        "\n",
        "        if neg:\n",
        "            tail = tail[1:]\n",
        "\n",
        "        if not tail:\n",
        "            raise ValueError(\"Missing verb after auxiliary\")\n",
        "\n",
        "        verb = vbase(tail[0])\n",
        "        obj = tail[1:]\n",
        "\n",
        "    elif verb_word in (\n",
        "        \"will\", \"would\", \"can\", \"could\",\n",
        "        \"should\", \"must\", \"may\", \"might\"\n",
        "    ):\n",
        "\n",
        "         tail = rest[1:]\n",
        "\n",
        "         neg = bool(tail and tail[0] == \"not\")\n",
        "\n",
        "         if neg:\n",
        "          tail = tail[1:]\n",
        "\n",
        "         if not tail:\n",
        "          raise ValueError(\"Missing verb after modal\")\n",
        "\n",
        "         verb = vbase(tail[0])\n",
        "         obj = tail[1:]\n",
        "\n",
        "    else:\n",
        "      verb = vbase(verb_word)\n",
        "      obj = rest[1:]\n",
        "      neg = False\n",
        "\n",
        "    if verb not in VERBS:\n",
        "        raise ValueError(\n",
        "            f\"Unsupported verb: {verb}. Tokens: {toks}\"\n",
        "        )\n",
        "\n",
        "    if not obj:\n",
        "        return [Lit(neg, verb, (subject,))]\n",
        "\n",
        "    out = []\n",
        "\n",
        "    for obj_part in split_on(obj, {\"and\", \",\"}):\n",
        "        if not obj_part:\n",
        "            continue\n",
        "\n",
        "        term = mk_term(obj_part, ctx, \"obj\")\n",
        "        out.append(Lit(neg, verb, (subject, term)))\n",
        "\n",
        "    return out\n",
        "\n",
        "def parse_conj(toks, ctx):\n",
        "    \"\"\"Parse a conjunction of clauses (\"A is big and kind, B likes C\") into a flat list of literals.\n",
        "    The shared context `ctx` resolves elided subjects and pronouns across the parts.\"\"\"\n",
        "    out = []\n",
        "    for part in split_on(list(toks), {\"and\", \",\"}):\n",
        "        out.extend(parse_clause(part, ctx))\n",
        "    return out\n",
        "\n",
        "def _quantified_rule(toks, sent):\n",
        "    \"\"\"Parse 'All big dogs are friendly' and 'Every dog chases cats'.\"\"\"\n",
        "    if not toks or toks[0] not in QUANT:\n",
        "        return None\n",
        "    k = pred_start(toks)\n",
        "    if k is None or k == 1:\n",
        "        return None\n",
        "    subject_phrase = toks[1:k]\n",
        "    if not subject_phrase:\n",
        "        return None\n",
        "\n",
        "    var = \"?x1\"\n",
        "    body = []\n",
        "    for mod in subject_phrase[:-1]:\n",
        "        if mod not in DETS and mod not in {\"and\", \",\"}:\n",
        "            body.append(Lit(False, mod, (var,)))\n",
        "    noun = singular_noun(subject_phrase[-1])\n",
        "    if noun in DETS:\n",
        "        raise ValueError(\"Quantified subject is missing a noun\")\n",
        "\n",
        "    generic_classes = {\"thing\", \"person\", \"one\", \"individual\"}\n",
        "    if noun not in generic_classes:\n",
        "        body.append(Lit(False, noun, (var,)))\n",
        "    ctx = Ctx()\n",
        "    ctx.set_subj(var)\n",
        "    heads = parse_clause(subject_phrase[-0:] + toks[k:], ctx) if False else parse_clause(toks[k:], ctx)\n",
        "\n",
        "    return [Rule(tuple(body), h, sent) for h in heads]\n",
        "\n",
        "def _generic_class_rule(toks, sent):\n",
        "    for j, token in enumerate(toks):\n",
        "        if token in GEN_NOUNS and j + 1 < len(toks) and toks[j+1] in (\"is\", \"are\"):\n",
        "            var = \"?x1\"\n",
        "            body = []\n",
        "            for part in split_on(toks[:j], {\"and\", \",\"}):\n",
        "                words = [w for w in part if w not in DETS]\n",
        "                if words:\n",
        "                    neg = words[0] == \"not\"\n",
        "                    if neg: words = words[1:]\n",
        "                    if words:\n",
        "                        body.append(Lit(neg, \"_\".join(words), (var,)))\n",
        "            ctx = Ctx()\n",
        "            ctx.set_subj(var)\n",
        "            heads = parse_clause(toks[j+1:], ctx)\n",
        "            return [Rule(tuple(body), h, sent) for h in heads]\n",
        "    return None\n",
        "\n",
        "def parse_sentence(sent):\n",
        "    toks = tokenize(sent)\n",
        "\n",
        "    if not toks:\n",
        "        return []\n",
        "\n",
        "    qr = _quantified_rule(toks, sent)\n",
        "    if qr is not None:\n",
        "        return qr\n",
        "\n",
        "    gr = _generic_class_rule(toks, sent)\n",
        "    if gr is not None:\n",
        "        return gr\n",
        "\n",
        "    if toks[0] == \"if\":\n",
        "\n",
        "        if \"then\" in toks:\n",
        "            i = toks.index(\"then\")\n",
        "            body_t = toks[1:i]\n",
        "            head_t = toks[i + 1:]\n",
        "\n",
        "        elif \",\" in toks:\n",
        "            i = toks.index(\",\")\n",
        "            body_t = toks[1:i]\n",
        "            head_t = toks[i + 1:]\n",
        "\n",
        "        else:\n",
        "            raise ValueError(\"Conditional missing separator\")\n",
        "\n",
        "        if not body_t or not head_t:\n",
        "            raise ValueError(\"Incomplete conditional\")\n",
        "\n",
        "        rules_out = []\n",
        "        seed = None\n",
        "\n",
        "        for disjunct in split_on(body_t, {\"or\"}):\n",
        "            ctx = Ctx()\n",
        "\n",
        "            if seed is not None:\n",
        "                ctx.set_subj(seed)\n",
        "                ctx.n = 1\n",
        "\n",
        "            body = parse_conj(disjunct, ctx)\n",
        "\n",
        "            if not body:\n",
        "                raise ValueError(\"Empty conditional antecedent\")\n",
        "\n",
        "            if seed is None:\n",
        "                seed = ctx.first\n",
        "\n",
        "            heads = parse_conj(head_t, ctx)\n",
        "\n",
        "            if not heads:\n",
        "                raise ValueError(\"Empty conditional consequent\")\n",
        "\n",
        "            rules_out.extend(Rule(tuple(body), h, sent) for h in heads)\n",
        "\n",
        "        return rules_out\n",
        "\n",
        "    ctx = Ctx()\n",
        "\n",
        "    return [\n",
        "        Rule((), lit, sent)\n",
        "        for lit in parse_clause(toks, ctx)\n",
        "    ]\n",
        "\n",
        "def split_sentences(text):\n",
        "    return [s.strip() for s in re.split(r\"(?<=[.!?])\\s+|\\n+\", text.strip()) if s.strip()]\n",
        "\n",
        "def parse_context(text):\n",
        "    learn_verbs(text)\n",
        "\n",
        "    rules = []\n",
        "    bad = []\n",
        "\n",
        "    for s in split_sentences(text):\n",
        "        try:\n",
        "            rules.extend(parse_sentence(s.rstrip(\".!?\")))\n",
        "        except Exception as e:\n",
        "            bad.append({\n",
        "                \"sentence\": s,\n",
        "                \"error\": str(e)\n",
        "            })\n",
        "\n",
        "    return rules, bad\n",
        "\n",
        "def parse_query(q):\n",
        "    q = q.strip().rstrip(\".?!\")\n",
        "    toks = tokenize(q)\n",
        "\n",
        "    if toks.count(\"if\") > 0 or \"then\" in toks:\n",
        "        raise ValueError(\"Nested conditional query not supported\")\n",
        "\n",
        "    if \"neither\" in toks and \"nor\" in toks:\n",
        "        i = toks.index(\"neither\")\n",
        "        j = toks.index(\"nor\", i)\n",
        "\n",
        "        left = toks[i + 1:j]\n",
        "        right = toks[j + 1:]\n",
        "\n",
        "        if not left or not right:\n",
        "            raise ValueError(\"Incomplete neither-nor query\")\n",
        "\n",
        "        left_lits = parse_clause(left, Ctx())\n",
        "        right_lits = parse_clause(right, Ctx())\n",
        "\n",
        "        left_lits = [\n",
        "            Lit(not lit.neg, lit.pred, lit.args)\n",
        "            for lit in left_lits\n",
        "        ]\n",
        "\n",
        "        right_lits = [\n",
        "            Lit(not lit.neg, lit.pred, lit.args)\n",
        "            for lit in right_lits\n",
        "        ]\n",
        "\n",
        "        return \"and\", left_lits + right_lits\n",
        "\n",
        "    if \"or\" in toks:\n",
        "        parts = split_on(toks, {\"or\"})\n",
        "        literals = []\n",
        "\n",
        "        for part in parts:\n",
        "            literals.extend(parse_clause(part, Ctx()))\n",
        "\n",
        "        return \"or\", literals\n",
        "\n",
        "    return \"and\", parse_clause(toks, Ctx())\n"
      ]
    },
    {
