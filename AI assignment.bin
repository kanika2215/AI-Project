        "  \"id\": \"22\",\n",
        "  \"context\": \"We know that Nuv causes Splee, Splee or Blen causes Druk, Druk and Plog together cause Wrox. We observed Blen and Plog.\",\n",
        "  \"question\": \"Would Wrox occur if not Nuv instead of Nuv?\",\n",
        "  \"label\": \"yes\",\n",
        "  \"type\": \"conditional\"\n",
        " },\n",
        " {\n",
        "  \"id\": \"23\",\n",
        "  \"context\": \"We know that Praf causes Vank, Vank or Scud causes Wrenk, Wrenk and Yobb together cause Klep. We observed Scud and Yobb.\",\n",
        "  \"question\": \"Would Klep occur if not Praf instead of Praf?\",\n",
        "  \"label\": \"yes\",\n",
        "  \"type\": \"conditional\"\n",
        " }\n",
        "]\n",
        "\n",
        "def _cb_records(f):\n",
        "    try:\n",
        "        from datasets import load_dataset\n",
        "        return load_dataset(CB_REPO, data_files=f, split=\"train\").to_list()\n",
        "    except Exception as e1:\n",
        "        try:\n",
        "            from huggingface_hub import hf_hub_download\n",
        "            d = json.load(open(hf_hub_download(CB_REPO, f, repo_type=\"dataset\"), encoding=\"utf8\"))\n",
        "            if isinstance(d, dict):\n",
        "                d = list(d.values()) if all(isinstance(v, dict) for v in d.values()) else \\\n",
        "                    [dict(zip(d, vals)) for vals in zip(*d.values())]\n",
        "            return d\n",
        "        except Exception as e2:\n",
        "            print(f\"could not load {f}: {e1!r} / {e2!r}\"); return []\n",
        "\n",
        "def load_counterbench():\n",
        "    rows = []\n",
        "    for f in CB_FILES:\n",
        "        for r in _cb_records(f):\n",
        "            rows.append({\"id\": r.get(\"question_id\"), \"context\": r.get(\"given_info\"), \"question\": r.get(\"question\"),\n",
        "                         \"label\": r.get(\"answer\"), \"type\": str(r.get(\"type\", \"\")).lower()})\n",
        "    return rows\n",
        "\n",
        "def cb_label(x): return str(x).strip().lower() in (\"yes\", \"true\", \"1\", \"entailment\")\n",
        "\n",
        "def cb_evaluate(rows, show_errors=8):\n",
        "    t0 = time.perf_counter(); preds = [cb_predict(r[\"context\"], r[\"question\"]) for r in rows]; dt = time.perf_counter() - t0\n",
        "    gold = [cb_label(r[\"label\"]) for r in rows]\n",
        "    acc = 100 * sum(p == g for p, g in zip(preds, gold)) / len(rows)\n",
        "    print(f\"examples={len(rows)}  inference time={dt:.3f}s  accuracy={acc:.2f}%\")\n",
        "    by = defaultdict(lambda: [0, 0])\n",
        "    for r, p, g in zip(rows, preds, gold): by[r[\"type\"]][0] += (p == g); by[r[\"type\"]][1] += 1\n",
        "    for k, (a, n) in sorted(by.items()): print(f\"   {k or '?':12s} {100*a/n:6.2f}%  ({n})\")\n",
        "    for r, p, g in [(r, p, g) for r, p, g in zip(rows, preds, gold) if p != g][:show_errors]:\n",
        "        print(\"  MISMATCH:\", r[\"context\"][:140], \"|\", r[\"question\"], \"| gold:\", g)\n",
        "    return {\"preds\": preds, \"accuracy\": acc, \"time\": dt}\n",
        "\n",
        "CB_ROWS = load_counterbench()\n",
        "if not CB_ROWS:\n",
        "    print(\"Hugging Face data unavailable -> using the embedded real sample (24 rows from the public preview)\")\n",
        "    CB_ROWS = CB_EMBEDDED_SAMPLE\n",
        "CB_RESULT = cb_evaluate(CB_ROWS)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "001418ca",
      "metadata": {
        "id": "001418ca"
      },
      "source": [
        "## Submission\n",
        "Reads the private test file (csv / json / jsonl), predicts with `predict_any`, prints inference time (and accuracy if labels are present) and writes `submission.csv`."
      ]
    },
