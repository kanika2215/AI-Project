      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Test file not found: test.csv. Place the assignment test file beside this notebook.\n"
          ]
        }
      ],
      "source": [
        "import os, csv, json, time\n",
        "\n",
        "_TEST_COLS = {\n",
        "    \"id\": [\"id\", \"ID\", \"idx\", \"qid\", \"question_id\", \"example_id\"],\n",
        "    \"context\": [\"context\", \"theory\", \"premises\", \"given_info\", \"knowledge_base\", \"kb\", \"text\", \"story\"],\n",
        "    \"question\": [\"question\", \"query\", \"statement\", \"conclusion\", \"hypothesis\"],\n",
        "    \"label\": [\"label\", \"answer\", \"gold\", \"target\"],\n",
        "}\n",
        "\n",
        "def read_test_file(path):\n",
        "    \"\"\"Read CSV, JSONL, or JSON and normalize common entailment schemas.\"\"\"\n",
        "    with open(path, encoding=\"utf8\") as f:\n",
        "        if path.lower().endswith(\".csv\"):\n",
        "            raw = list(csv.DictReader(f))\n",
        "        elif path.lower().endswith(\".jsonl\"):\n",
        "            raw = [json.loads(line) for line in f if line.strip()]\n",
        "        elif path.lower().endswith(\".json\"):\n",
        "            raw = json.load(f)\n",
        "        else:\n",
        "            raise ValueError(\"Supported test formats: .csv, .json, .jsonl\")\n",
        "\n",
        "    # Some JSON exports wrap examples in a top-level key.\n",
        "    if isinstance(raw, dict):\n",
        "        for key in (\"data\", \"examples\", \"test\", \"rows\"):\n",
        "            if isinstance(raw.get(key), list):\n",
        "                raw = raw[key]\n",
        "                break\n",
        "        else:\n",
        "            raise ValueError(\"JSON must contain a list or a list under data/examples/test/rows\")\n",
        "    if not isinstance(raw, list):\n",
        "        raise ValueError(\"Test file must contain a list of examples\")\n",
        "\n",
        "    rows = []\n",
        "    for i, item in enumerate(raw):\n",
        "        if not isinstance(item, dict):\n",
        "            raise ValueError(f\"Example {i} is not an object\")\n",
        "        def get_field(name):\n",
        "            return next((item[c] for c in _TEST_COLS[name]\n",
        "                        if c in item and item[c] is not None), None)\n",
        "        context, question = get_field(\"context\"), get_field(\"question\")\n",
        "        if isinstance(context, (list, tuple)):\n",
        "            context = \"\\\\n\".join(map(str, context))\n",
        "        if context is None or question is None:\n",
        "            raise ValueError(f\"Example {i} needs context/premises and question/conclusion\")\n",
        "        rows.append({\n",
        "            \"id\": get_field(\"id\") if get_field(\"id\") is not None else i,\n",
        "            \"context\": str(context),\n",
        "            \"question\": str(question),\n",
        "            \"label\": get_field(\"label\"),\n",
        "        })\n",
        "    return rows\n",
        "\n",
        "def submission_label(prediction):\n",
        "    \"\"\"Map the agent's entailment decision to the assignment's binary labels.\"\"\"\n",
        "    if prediction is True or str(prediction).strip().lower() in {\"true\", \"yes\", \"entailment\", \"entailed\", \"1\"}:\n",
        "        return \"True\"\n",
        "    # The assignment requires a binary True/False submission. Unknown/unsupported\n",
        "    # cases are conservatively treated as not entailed; report them separately.\n",
        "    return \"False\"\n",
        "\n",
        "TEST_PATH = \"test.csv\"\n",
        "if os.path.exists(TEST_PATH):\n",
        "    test_rows = read_test_file(TEST_PATH)\n",
        "    t0 = time.perf_counter()\n",
        "    raw_preds = [predict_any(r[\"context\"], r[\"question\"]) for r in test_rows]\n",
        "    dt = time.perf_counter() - t0\n",
        "    preds = [submission_label(p) for p in raw_preds]\n",
        "    uncertain_count = sum(str(p).strip().lower() in {\"uncertain\", \"unknown\", \"none\"} for p in raw_preds)\n",
        "    print(f\"Queries: {len(test_rows)}\")\n",
        "    print(f\"Inference time: {dt:.3f} seconds\")\n",
        "    print(f\"Uncertain/unsupported predictions mapped to False: {uncertain_count}\")\n",
        "\n",
        "    labeled = [r for r in test_rows if r[\"label\"] is not None]\n",
        "    if labeled:\n",
        "        yes_labels = {\"true\", \"yes\", \"1\", \"entailment\", \"entailed\"}\n",
        "        gold = [str(r[\"label\"]).strip().lower() in yes_labels for r in labeled]\n",
        "        pred_labeled = [submission_label(predict_any(r[\"context\"], r[\"question\"])) for r in labeled]\n",
        "        accuracy = 100 * sum((p == \"True\") == g for p, g in zip(pred_labeled, gold)) / len(labeled)\n",
        "        print(f\"Accuracy on labeled test rows: {accuracy:.2f}%\")\n",
        "\n",
        "    with open(\"submission.csv\", \"w\", newline=\"\", encoding=\"utf8\") as f:\n",
        "        writer = csv.writer(f)\n",
        "        writer.writerow([\"id\", \"label\"])\n",
        "        writer.writerows((r[\"id\"], p) for r, p in zip(test_rows, preds))\n",
        "    print(\"Created submission.csv\")\n",
        "else:\n",
        "    print(f\"Test file not found: {TEST_PATH}. Place the assignment test file beside this notebook.\")\n"
      ]
    }
  ],
